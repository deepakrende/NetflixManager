# ---- Telegram ----
TELEGRAM_TOKEN=
ADMIN_ID=

# ---- Gmail (read-only OAuth) ----
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REFRESH_TOKEN=

# ---- storage (point these at the Railway Volume, e.g. /data) ----
DATA_FILE=/data/customers.json
ACCOUNTS_FILE=/data/accounts.json
SESSIONS_DIR=/data/sessions

# ---- subscriptions ----
LOGIN_CHANGE_COOLDOWN_HOURS=24

# ---- device cleanup (start with "dry", switch to "on" once verified) ----
DEVICE_CLEANUP=dry
DEVICE_CLEANUP_DELAY_MIN=5
WATCH_INTERVAL_SEC=60
WATCH_CLEANUP_DELAY_MIN=1
BOT_DEVICE_HINT=linux

# ---- optional: auto password-reset when an account is released ----
AUTO_RESET=0
